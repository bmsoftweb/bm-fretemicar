# MySQL: banco cteauto (tabela usuarios do login e as cte_*)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=cteauto
# Empresa gravada nas tabelas cte_* (uma só por enquanto)
ID_EMPRESA=1
# Cookie de sessão e cifra das senhas das contas de e-mail (mínimo 32 caracteres; trocar invalida as senhas gravadas)
SESSION_SECRET=
# BMapi da base BMsoft (DBISAM) onde os CT-e são lançados
BMAPI_URL=http://localhost:9000
BMAPI_TOKEN=

# Leitura direta da SEFAZ (CTeDistribuicaoDFe), ao lado do e-mail: não usa variável de ambiente. O certificado
# A1 (.pfx) é enviado na tela Configuração e fica no banco (cte_config), com a senha cifrada (SESSION_SECRET);
# é opcional — sem ele, só o e-mail é lido.

# Busca automática (Vercel Cron, vercel.json: /api/cron/leitura de 90 em 90 min). A Vercel manda sozinha o cabeçalho
# com este valor quando a variável existe aqui; sem ela, a rota fica aberta (só para testar local sem configurar).
# O cron de hora em hora exige plano pago na Vercel (Hobby só permite 1x/dia); sem isso, dá para usar um serviço
# externo (cron-job.org, GitHub Actions…) chamando a mesma URL com o cabeçalho "Authorization: Bearer <este valor>".
CRON_SECRET=
