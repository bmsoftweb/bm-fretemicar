# MySQL: banco cteauto (tabela usuarios do login e as cte_*)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=cteauto
# Empresa gravada nas tabelas cte_* (uma só por enquanto)
ID_EMPRESA=1
# Cookie de sessão e cifra das senhas das contas de e-mail (mínimo 32 caracteres; trocar invalida as senhas gravadas)
SESSION_SECRET=
# BMapi da base BMsoft (DBISAM) onde os CT-e são lançados
BMAPI_URL=http://localhost:9000
BMAPI_TOKEN=
